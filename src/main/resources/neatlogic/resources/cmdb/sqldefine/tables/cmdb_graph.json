{
  "moduleId": "cmdb",
  "name": "cmdb_graph",
  "label": "配置管理graph表",
  "description": "配置管理graph表，属于配置管理模块的数据表。 可用于配置管理相关的启用状态筛选、时间维度统计等报表查询场景。",
  "fields": [
    {
      "name": "id",
      "type": "bigint",
      "description": "主键ID，作为当前表记录的主键或唯一定位字段。"
    },
    {
      "name": "name",
      "type": "varchar(255)",
      "description": "唯一标识。"
    },
    {
      "name": "description",
      "type": "varchar(500)",
      "description": "描述。"
    },
    {
      "name": "is_active",
      "type": "tinyint",
      "description": "是否激活。"
    },
    {
      "name": "icon",
      "type": "varchar(50)",
      "description": "配置管理graph表的icon字段。"
    },
    {
      "name": "config",
      "type": "longtext",
      "description": "配置。"
    },
    {
      "name": "type",
      "type": "enum('private','public','scene')",
      "description": "类型。"
    },
    {
      "name": "fcd",
      "type": "timestamp(3)",
      "description": "创建时间。"
    },
    {
      "name": "fcu",
      "type": "char(32)",
      "description": "创建人。"
    },
    {
      "name": "lcd",
      "type": "timestamp(3)",
      "description": "修改时间。"
    },
    {
      "name": "lcu",
      "type": "char(32)",
      "description": "修改人。"
    }
  ],
  "indexes": [
    {
      "name": "PRIMARY",
      "type": "BTREE",
      "unique": true,
      "primary": true,
      "columns": [
        "id"
      ],
      "description": "主键索引，覆盖 id 字段，适合用于唯一定位记录和主表关联查询。"
    }
  ]
}
