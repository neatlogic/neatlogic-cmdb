{
  "moduleId": "cmdb",
  "name": "cmdb_citype",
  "label": "cmdb配置项类型表",
  "description": "cmdb配置项类型表 可用于配置管理相关数据的查询、筛选和报表展示。",
  "fields": [
    {
      "name": "id",
      "type": "bigint",
      "description": "id，作为当前表记录的主键或唯一定位字段。"
    },
    {
      "name": "name",
      "type": "varchar(100)",
      "description": "类型名称。"
    },
    {
      "name": "sort",
      "type": "int",
      "description": "排序。"
    },
    {
      "name": "is_menu",
      "type": "tinyint(1)",
      "description": "是否在菜单中显示。"
    },
    {
      "name": "icon",
      "type": "varchar(50)",
      "description": "图标。"
    },
    {
      "name": "is_showintopo",
      "type": "tinyint(1)",
      "description": "是否在topo图中展示。"
    }
  ],
  "indexes": [
    {
      "name": "PRIMARY",
      "type": "BTREE",
      "unique": true,
      "primary": true,
      "columns": [
        "id"
      ],
      "description": "主键索引，覆盖 id 字段，适合用于唯一定位记录和主表关联查询。"
    }
  ]
}
