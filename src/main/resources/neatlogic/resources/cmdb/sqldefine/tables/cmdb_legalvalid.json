{
  "moduleId": "cmdb",
  "name": "cmdb_legalvalid",
  "label": "合规设置表",
  "description": "合规设置表 可用于配置管理相关的启用状态筛选、关联查询等报表查询场景。",
  "fields": [
    {
      "name": "id",
      "type": "bigint",
      "description": "id，作为当前表记录的主键或唯一定位字段。"
    },
    {
      "name": "name",
      "type": "varchar(50)",
      "description": "名称。"
    },
    {
      "name": "type",
      "type": "enum('ci','custom')",
      "description": "校验类型。"
    },
    {
      "name": "ci_id",
      "type": "bigint",
      "description": "模型id，已建立普通索引，适合用于过滤、关联或排序查询。"
    },
    {
      "name": "rule",
      "type": "text",
      "description": "规则。"
    },
    {
      "name": "cron",
      "type": "varchar(500)",
      "description": "定时表达式。"
    },
    {
      "name": "is_active",
      "type": "tinyint(1)",
      "description": "是否激活。"
    }
  ],
  "indexes": [
    {
      "name": "PRIMARY",
      "type": "BTREE",
      "unique": true,
      "primary": true,
      "columns": [
        "id"
      ],
      "description": "主键索引，覆盖 id 字段，适合用于唯一定位记录和主表关联查询。"
    },
    {
      "name": "idx_ci_id",
      "type": "BTREE",
      "unique": false,
      "primary": false,
      "columns": [
        "ci_id"
      ],
      "description": "普通索引，覆盖 ci_id 字段，适合用于过滤、关联或排序查询。"
    }
  ]
}
